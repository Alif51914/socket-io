# Node.js-এর হালকা ভার্সন ব্যবহার করছি
FROM node:18-alpine

# কন্টেইনারের ভেতরে /app নামে একটি ফোল্ডার তৈরি করছি
WORKDIR /app

# প্যাকেজ ফাইলগুলো কপি করছি
COPY package*.json ./

# ডিপেন্ডেন্সি ইনস্টল করছি
RUN npm install

# বাকি সব কোড কপি করছি
COPY . .

# আপনার সার্ভার যে পোর্টে চলছে, সেটি এক্সপোজ করছি (ধরি 5000, আপনি নিচে চেক করে নিন)
EXPOSE 5000

# সার্ভার রান করার কমান্ড
CMD ["node", "index.js"]